{
  "expo": {
    "name": "OJT Budget",
    "slug": "ojt-budget-tracker",
    "scheme": "ojtbudget",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ojt.budgettracker"
    },
    "android": {
      "package": "com.ojt.budgettracker",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": { "backgroundColor": "#0A0A0A" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
